# ── Build output (generated by `make`) ───────────────────────────────
build/
dist/

# ── Local toolchain / vendored dev tools (tools/bootstrap.sh) ─────────
.tools/
.venv/
venv/

# ── Python caches and tooling ───────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.ruff_cache/
.pytest_cache/
.mypy_cache/
*.egg-info/

# ── Compiled objects, libraries and images ───────────────────────────
*.o
*.obj
*.lo
*.a
*.so
*.so.*
*.elf
*.map
*.ko
*.img
*.iso
*.deb

# ── Third-party build artifacts (sources themselves are tracked) ─────
third_party/musl/obj/
third_party/musl/lib/
third_party/musl/config.mak
third_party/musl/config.log
third_party/bearssl/build/
third_party/quickjs/.obj/
third_party/quickjs/qjs

# ── Editor / OS noise ────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-workspace

# ── Local agent / tooling state ──────────────────────────────────────
.claude/

# ── Secrets and local-only configuration ─────────────────────────────
*.local
.env
.env.*
