+				const auto& origin = inlines.back().element->pos();
+				inlines.back().box.x += origin.x;
+				inlines.back().box.y += origin.y;
 				inlines.back().element->add_inline_box(inlines.back().box);
 				inlines.pop_back();
 			}
@@ -696,6 +709,9 @@ std::list< std::unique_ptr<litehtml::line_box_item> > litehtml::line_box::finish
 	for(auto iter = inlines.rbegin(); iter != inlines.rend(); ++iter)
 	{
 		iter->box.width =  m_items.back()->right() - iter->box.x;
+		const auto& origin = iter->element->pos();
+		iter->box.x += origin.x;
+		iter->box.y += origin.y;
 		iter->element->add_inline_box(iter->box);
 
 		ret_items.emplace_front(std::unique_ptr<line_box_item>(new lbi_continue(iter->element)));
