-				lbi->get_el()->clear_inline_boxes();
+				auto& item = *lbi->get_el();
+				item.clear_inline_boxes();
+				// Each inline can have multiple markers and layout passes.
+				// Set its origin once so its descendants move by one offset.
+				item.pos().x = item.pos().y = 0;
+				item.apply_relative_shift(containing_block_size);
 			}
 			inlines.emplace_back(lbi->get_el());
 			inlines.back().box.x = lbi->left();
