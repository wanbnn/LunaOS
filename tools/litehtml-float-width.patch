diff --git a/src/line_box.cpp b/src/line_box.cpp
index 091a96c..d13cb32 100644
--- a/src/line_box.cpp
+++ b/src/line_box.cpp
@@ -621,6 +621,10 @@ std::list< std::unique_ptr<litehtml::line_box_item> > litehtml::line_box::finish
 	current_context.start_lbi = nullptr;
 	//int va_top_bottom = 0;
 
+	// A float shares the line with the content before it, so the line is
+	// as wide as the content and the float together.
+	m_rendered_width.natural_width += m_float_width;
+
 	// Second pass:
 	// 1. Vertical align top/bottom
 	// 2. Apply relative shift
@@ -669,14 +673,20 @@ std::list< std::unique_ptr<litehtml::line_box_item> > litehtml::line_box::finish
 			lbi->pos().y += m_top + top_shift;
 		}
 
