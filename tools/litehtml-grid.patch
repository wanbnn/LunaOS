+#ifndef LITEHTML_RENDER_GRID_H
+#define LITEHTML_RENDER_GRID_H
+
+#include "document.h"
+#include "html_tag.h"
+#include "render_flex.h"
+
+namespace litehtml
+{
+    // Row auto-placement for explicit columns, the layout used by the
+    // sponsorship cards and responsive lists.
+    class render_item_grid final : public render_item_flex
+    {
+        static constexpr int max_columns = 128;
+        struct track
+        {
+            pixel_t minimum = 0;
+            float fraction = 0;
+        };
+
+        static const property_value& property(const element& el, string_id name)
+        {
+            static const property_value empty;
+            const auto* tag = dynamic_cast<const html_tag*>(&el);
+            return tag ? tag->specified_property(name) : empty;
+        }
+
+        pixel_t pixels(css_length length, pixel_t width) const
+        {
+            src_el()->get_document()->cvt_units(length, css().get_font_metrics(), width);
+            return length.calc_percent(width);
+        }
+
+        pixel_t gap(string_id name, pixel_t width) const
+        {
+            const auto& value = property(*src_el(), name);
+            return value.is<css_length>() ? pixels(value.get<css_length>(), width) : 0;
+        }
+
+        bool parse_track(const css_token& token, pixel_t width, track& out) const
+        {
+            if (token.type == DIMENSION && lowcase(token.unit) == "fr" && token.n.number >= 0)
+            {
+                out = {0, token.n.number};
+                return true;
+            }
+            if (token.ident() == "auto")
+            {
+                out = {0, 1};
+                return true;
+            }
+            if (token.type == CV_FUNCTION && lowcase(token.name) == "minmax" &&
+                token.value.size() == 3 && token.value[1].type == COMMA)
+            {
+                track minimum, maximum;
+                if (!parse_track(token.value.front(), width, minimum) ||
+                    !parse_track(token.value.back(), width, maximum))
+                    return false;
+                out = {std::max(minimum.minimum, maximum.minimum), maximum.fraction};
+                return true;
+            }
+            css_length length;
+            if (!length.from_token(token, f_length_percentage | f_positive))
+                return false;
+            out = {pixels(length, width), 0};
+            return true;
+        }
+
+        vector<track> columns(pixel_t width, pixel_t spacing, int items) const
+        {
+            const auto& property_value = property(*src_el(), _id("grid-template-columns"));
+            if (!property_value.is<css_token_vector>())
+                return {{0, 1}};
+            vector<track> result;
+            for (const auto& token : property_value.get<css_token_vector>())
+            {
+                track value;
+                if (token.type == CV_FUNCTION && lowcase(token.name) == "repeat" &&
+                    token.value.size() >= 3 && token.value[1].type == COMMA)
+                {
+                    const auto& count = token.value.front();
+                    const auto keyword = count.ident();
+                    if ((keyword == "auto-fit" || keyword == "auto-fill") && token.value.size() == 3 &&
+                        parse_track(token.value.back(), width, value))
+                    {
+                        const auto available = std::max(0.0f, width + spacing);
+                        const auto step = std::max(1.0f, value.minimum + spacing);
+                        int n = static_cast<int>(std::min(float(max_columns), available / step));
+                        if (keyword == "auto-fit")
+                            n = std::min(n, items);
+                        result.insert(result.end(), std::max(1, n), value);
+                    }
+                    else if (count.type == NUMBER && count.n.number_type == css_number_integer &&
+                             count.n.number >= 1 && count.n.number <= max_columns)
+                    {
+                        vector<track> pattern;
+                        for (size_t i = 2; i < token.value.size(); ++i)
+                        {
+                            if (!parse_track(token.value[i], width, value))
+                                return {{0, 1}};
+                            pattern.push_back(value);
+                        }
+                        const int repeat = static_cast<int>(count.n.number);
+                        if (pattern.size() * repeat + result.size() > max_columns)
+                            return {{0, 1}};
+                        for (int i = 0; i < repeat; ++i)
+                            result.insert(result.end(), pattern.begin(), pattern.end());
+                    }
+                    else
+                        return {{0, 1}};
+                }
+                else if (parse_track(token, width, value))
+                    result.push_back(value);
+                else
+                    return {{0, 1}};
+                if (result.size() > max_columns)
+                    return {{0, 1}};
+            }
+            return result.empty() ? vector<track>{{0, 1}} : result;
+        }
+
+        static int grid_line(const css_token& token, int columns)
+        {
+            if (token.type != NUMBER || token.n.number_type != css_number_integer ||
+                token.n.number < -columns - 1 || token.n.number > columns + 1 ||
+                token.n.number == 0)
+                return -1;
+            const int line = static_cast<int>(token.n.number);
+            return line > 0 ? line - 1 : columns + 1 + line;
+        }
+
+        rendered_width _render_content(pixel_t, pixel_t, bool second_pass,
+                                       const containing_block_context& size,
+                                       formatting_context* context) override
+        {
+            const auto row_gap = gap(_id("row-gap"), size.render_width);
+            const auto column_gap = gap(_id("column-gap"), size.render_width);
+            int items = 0;
+            for (const auto& child : children())
+            {
+                const auto position = child->css().get_position();
+                if (position != element_position_absolute && position != element_position_fixed)
+                    ++items;
+            }
+            auto tracks = columns(size.render_width, column_gap, items);
+            const int count = static_cast<int>(tracks.size());
+            pixel_t minimum = (count - 1) * column_gap;
+            for (const auto& track : tracks)
+                minimum += track.minimum;
+
+            // Freeze tracks whose minimum already exceeds their share.
+            pixel_t space = std::max(0.0f, size.render_width - (count - 1) * column_gap);
+            float fractions = 0;
+            for (const auto& track : tracks)
+            {
+                fractions += track.fraction;
+                if (!track.fraction)
+                    space -= track.minimum;
+            }
+            for (bool changed = true; changed && fractions > 0;)
+            {
+                changed = false;
+                for (auto& track : tracks)
+                {
+                    if (track.fraction && track.minimum > space * track.fraction / fractions)
+                    {
+                        space -= track.minimum;
+                        fractions -= track.fraction;
+                        track.fraction = 0;
+                        changed = true;
+                    }
+                }
+            }
+            vector<pixel_t> edges(1, 0);
+            for (const auto& track : tracks)
+            {
+                pixel_t width = track.fraction ? space * track.fraction / fractions : track.minimum;
+                edges.push_back(edges.back() + width + column_gap);
+            }
+
+            int column = 0;
+            pixel_t top = 0, row_height = 0;
+            vector<render_item*> row;
+            auto finish_row = [&]()
+            {
+                for (auto* child : row)
+                {
+                    if (child->css().get_height().is_predefined() && !child->src_el()->is_replaced())
+                        child->pos().height += row_height - child->height();
+                }
+                row.clear();
+                top += row_height + row_gap;
+                row_height = 0;
+                column = 0;
+            };
+            for (const auto& child : children())
+            {
+                const auto position = child->css().get_position();
+                if (position == element_position_absolute || position == element_position_fixed)
+                {
+                    if (!second_pass)
+                        child->render(0, top, size, context);
+                    continue;
+                }
+                int start = -1, span = 1;
+                const auto& placement = property(*child->src_el(), _id("grid-column"));
+                if (placement.is<css_token_vector>())
+                {
+                    const auto& tokens = placement.get<css_token_vector>();
+                    if (!tokens.empty())
+                        start = grid_line(tokens.front(), count);
+                    if (start >= count)
+                        start = -1;
+                    if (tokens.size() == 3 && tokens[1].ch == '/' && start >= 0)
+                        span = std::max(1, grid_line(tokens.back(), count) - start);
+                    const size_t span_at = tokens.size() == 4 && tokens[1].ch == '/' ? 2 : 0;
+                    if (tokens.size() == span_at + 2 && tokens[span_at].ident() == "span")
+                    {
+                        int end = grid_line(tokens.back(), count);
+                        if (end >= 0)
+                            span = std::min(count, end + 1);
+                    }
+                }
+                if ((start >= 0 && start < column) || (start < 0 && column + span > count))
+                    finish_row();
+                if (start >= 0)
+                    column = start;
+                const int end = std::min(count, column + span);
+                const auto width = edges[end] - edges[column] - column_gap;
+                child->render(edges[column], top, size.new_width(width), context);
+                row_height = std::max(row_height, child->height());
+                row.push_back(child.get());
+                column = end;
+            }
+            if (!row.empty())
+                finish_row();
+            m_pos.height = items ? top - row_gap : 0;
+            return {edges.back() - column_gap, minimum};
+        }
+
+    public:
+        using render_item_flex::render_item_flex;
+        std::shared_ptr<render_item> clone() override
+        {
+            return std::make_shared<render_item_grid>(src_el());
+        }
+    };
+}
+
+#endif
